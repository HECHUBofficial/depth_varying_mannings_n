def save_outputs(hdf_path, summaries, audit_rows, args):
    folder = os.path.dirname(os.path.abspath(hdf_path))
    base = os.path.basename(hdf_path)
    mode_text = "preview" if args.preview else "applied"

    summary_csv = os.path.join(folder, f"{base}_depth_varying_n_{mode_text}_summary.csv")
    audit_csv = os.path.join(folder, f"{base}_depth_varying_n_{mode_text}_audit.csv")
    pdf_report = os.path.join(folder, f"{base}_depth_varying_n_{mode_text}_report.pdf")

    pd.DataFrame(summaries).to_csv(summary_csv, index=False)
    pd.DataFrame(audit_rows).to_csv(audit_csv, index=False)

    return summary_csv, audit_csv, pdf_report


