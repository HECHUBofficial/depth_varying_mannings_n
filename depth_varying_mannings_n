def parse_args():
    parser = argparse.ArgumentParser(
        description="Apply depth-varying Manning's n to HEC-RAS 2D Faces Area Elevation Values."
    )

    parser.add_argument(
        "hdf_path",
        nargs="?",
        default=DEFAULT_HDF_PATH,
        help="Path to HEC-RAS geometry HDF. If omitted, uses default .g03 copied/safe HDF.",
    )

    parser.add_argument(
        "--preview",
        action="store_true",
        help="Preview only. Do not modify the HDF.",
    )

    parser.add_argument(
        "--units",
        choices=["feet", "meter"],
        default="feet",
        help="Model units for curve depths. Default: feet.",
    )

    parser.add_argument(
        "--blend",
        type=float,
        default=0.50,
        help="Blend factor between original n and curve n. Default: 0.50.",
    )

    parser.add_argument(
        "--elev-col",
        type=int,
        default=0,
        help="Elevation column in Faces Area Elevation Values. Default: 0.",
    )

    parser.add_argument(
        "--n-col",
        type=int,
        default=3,
        help="Manning's n column in Faces Area Elevation Values. Default: 3.",
    )

    parser.add_argument(
        "--min-n",
        type=float,
        default=DEFAULT_MIN_N,
        help="Minimum allowed Manning's n. Default: 0.025.",
    )

    parser.add_argument(
        "--max-n",
        type=float,
        default=DEFAULT_MAX_N,
        help="Maximum allowed Manning's n. Default: 0.500.",
    )

    parser.add_argument(
        "--curve-points",
        default=None,
        help=(
            "Optional custom curve as depth:n pairs. "
            "Example: 0.02:0.50,0.05:0.50,0.50:0.153,1.00:0.070"
        ),
    )

    parser.add_argument(
        "--keep-first-row",
        action="store_true",
        help="Keep original n for first row of each face table.",
    )

    parser.add_argument(
        "--modify-last-row",
        action="store_true",
        help="Modify deepest/last row. By default, deepest row is kept unchanged.",
    )

    parser.add_argument(
        "--no-backup",
        action="store_true",
        help="Skip backup. Not recommended.",
    )

    return parser.parse_args()


# =============================================================================
# MAIN
# =============================================================================

def main():
    args = parse_args()

    hdf_path = args.hdf_path

    # Safer default: keep deepest/last row unchanged unless user explicitly modifies it.
    args.keep_last_row = not args.modify_last_row

    if not os.path.isfile(hdf_path):
        print("\nERROR: HDF file not found.")
        print(f"Path used:\n  {hdf_path}")
        sys.exit(1)

    if args.blend < 0.0 or args.blend > 1.0:
        print("\nERROR: --blend must be between 0.0 and 1.0.")
        sys.exit(1)

    if args.min_n <= 0 or args.max_n <= 0 or args.min_n >= args.max_n:
        print("\nERROR: Invalid --min-n and --max-n values.")
        sys.exit(1)

    print("\n======================================================")
    print("HEC-RAS 2D Depth-Varying Manning's n Tool")
    print("Final Version with PDF Report")
    print("======================================================")
    print(f"HDF file: {hdf_path}")
    print(f"Mode: {'PREVIEW ONLY - HDF will not be modified' if args.preview else 'APPLY - HDF will be modified'}")
    print(f"Units: {args.units}")
    print(f"Blend: {args.blend}")
    print(f"Elevation column: {args.elev_col}")
    print(f"Manning's n column: {args.n_col}")
    print(f"Keep first row: {args.keep_first_row}")
    print(f"Keep last row: {args.keep_last_row}")

    curve_depths, curve_n_values = get_curve(args)

    print("\nCurve used:")
    for d, n in zip(curve_depths, curve_n_values):
        print(f"  Depth/R = {d:.4f}, n = {n:.4f}")

    backup_path = None

    if not args.preview and not args.no_backup:
        backup_path = make_backup(hdf_path)
        print("\nBackup created:")
        print(f"  {backup_path}")
    elif not args.preview and args.no_backup:
        print("\nWARNING: Backup skipped because --no-backup was used.")

    mode = "r" if args.preview else "r+"

    summaries = []
    audit_rows = []

    try:
        with h5py.File(hdf_path, mode) as hdf:
            values_paths = find_values_datasets(hdf)

            if not values_paths:
                print("\nERROR: No Faces Area Elevation Values dataset found.")
                print("Datasets containing 'faces area elevation':")
                for path in visit_hdf_datasets(hdf):
                    if "faces area elevation" in path.lower():
                        print(f"  /{path}")
                sys.exit(1)

            print("\nFound Faces Area Elevation Values dataset(s):")
            for path in values_paths:
                print(f"  /{path}")

            for values_path in values_paths:
                print("\n------------------------------------------------------")
                print(f"Processing: /{values_path}")

                summary, audit = process_values_dataset(
                    hdf=hdf,
                    values_path=values_path,
                    args=args,
                )

                summaries.append(summary)
                audit_rows.extend(audit)

                print("\nChange summary:")
                print(f"  Faces modified: {summary['faces_modified']:,}")
                print(f"  Rows modified: {summary['rows_modified']:,}")
                print(f"  Original n mean: {summary['original_n_mean']:.6f}")
                print(f"  New n mean: {summary['new_n_mean']:.6f}")
                print(f"  Original n range: {summary['original_n_min']:.6f} to {summary['original_n_max']:.6f}")
                print(f"  New n range: {summary['new_n_min']:.6f} to {summary['new_n_max']:.6f}")

    except OSError as e:
        print("\nERROR: Could not open HDF file.")
        print(str(e))
        print("\nClose HEC-RAS if it is open, then try again.")
        sys.exit(1)

    if summaries:
        summary_csv, audit_csv, pdf_report = save_outputs(hdf_path, summaries, audit_rows, args)

        create_pdf_report(
            pdf_path=pdf_report,
            hdf_path=hdf_path,
            backup_path=backup_path,
            summaries=summaries,
            curve_depths=curve_depths,
            curve_n_values=curve_n_values,
            args=args,
        )

        print("\nOutput files created:")
        print(f"  Summary CSV: {summary_csv}")
        print(f"  Audit CSV:   {audit_csv}")
        print(f"  PDF Report:  {pdf_report}")

    print("\nDone.")

    if args.preview:
        print("\nPreview completed. No HDF values were changed.")
        print("To apply changes, run:")
        print("  python Depth_n.py")
    else:
        print("\nNext steps:")
        print("  1) Open HEC-RAS.")
        print("  2) Use the copied .g03 geometry/plan.")
        print("  3) Do not recompute 2D hydraulic property tables unless you rerun this script.")
        print("  4) Run the copied plan.")
        print("  5) Review hydrograph timing, peak, depth grid, velocity grid, and Courant grid.")
        print("  6) Open the PDF report to see exactly what changed.")


if __name__ == "__main__":
