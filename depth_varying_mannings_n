DEFAULT_HDF_PATH = (
    r"C:\YourProject\YourModel.g01.hdf"
)

# HEC-15 inspired Class C curve, feet
HEC15_CLASS_C_CURVE_FEET = [
    (0.02, 0.500),
    (0.05, 0.500),
    (0.10, 0.500),
    (0.20, 0.500),
    (0.50, 0.153),
    (1.00, 0.070),
    (2.00, 0.050),
    (3.00, 0.044),
]

# Same curve, meters
HEC15_CLASS_C_CURVE_METERS = [
    (0.006, 0.500),
    (0.015, 0.500),
    (0.030, 0.500),
    (0.061, 0.500),
    (0.152, 0.153),
    (0.305, 0.070),
    (0.610, 0.050),
    (0.914, 0.044),
]

DEFAULT_MIN_N = 0.025
DEFAULT_MAX_N = 0.500


# =============================================================================
# BASIC HELPERS
# =============================================================================

def timestamp_string():
    return datetime.now().strftime("%Y%m%d_%H%M%S")


def make_backup(hdf_path):
    folder = os.path.dirname(os.path.abspath(hdf_path))
    base = os.path.basename(hdf_path)
    backup_path = os.path.join(folder, f"{base}.backup_{timestamp_string()}")
    shutil.copy2(hdf_path, backup_path)
    return backup_path


def visit_hdf_datasets(hdf):
    datasets = []

    def visitor(name, obj):
        if isinstance(obj, h5py.Dataset):
            datasets.append(name)

    hdf.visititems(visitor)
    return datasets


def find_values_datasets(hdf):
    """
    Finds only actual Faces Area Elevation Values tables.
    This avoids accidentally processing Faces Area Elevation Info.
    """
    datasets = visit_hdf_datasets(hdf)
    values_paths = []

    for path in datasets:
        if path.lower().endswith("faces area elevation values"):
            values_paths.append(path)

    return values_paths


def find_info_dataset_for_values(hdf, values_path):
    """
    For:
        Geometry/2D Flow Areas/Reservoir/Faces Area Elevation Values

    find:
        Geometry/2D Flow Areas/Reservoir/Faces Area Elevation Info
    """
    group = "/".join(values_path.split("/")[:-1])
    expected_info_path = group + "/Faces Area Elevation Info"

    if expected_info_path in hdf:
        return expected_info_path

    for path in visit_hdf_datasets(hdf):
        if path.lower().endswith("faces area elevation info"):
            if "/".join(path.split("/")[:-1]) == group:
                return path

    return None


def read_numeric_matrix(ds):
    """
    Reads HDF dataset into numeric 2D matrix.
    """
    arr = ds[()]

    if arr.dtype.names:
        field_names = list(arr.dtype.names)
        matrix = np.column_stack([arr[name] for name in field_names]).astype(float)
        return matrix, True, field_names

    if arr.ndim == 1:
        matrix = arr.reshape(-1, 1).astype(float)
    elif arr.ndim == 2:
        matrix = arr.astype(float)
    else:
        raise ValueError(f"Unsupported dataset dimension: {arr.ndim}")

    return matrix, False, None


def write_numeric_matrix(ds, matrix, original_structured=False, field_names=None):
    """
    Writes modified numeric matrix back to original HDF dataset.
    """
    if original_structured:
        out = np.empty(matrix.shape[0], dtype=ds.dtype)
        for i, name in enumerate(field_names):
            out[name] = matrix[:, i].astype(ds.dtype[name])
        ds[...] = out
    else:
        if ds.ndim == 1:
            ds[...] = matrix[:, 0].astype(ds.dtype)
        else:
            ds[...] = matrix.astype(ds.dtype)


def stats_dict(values):
    values = np.asarray(values, dtype=float)
    finite = values[np.isfinite(values)]

    if finite.size == 0:
        return {
            "min": np.nan,
            "max": np.nan,
            "mean": np.nan,
            "median": np.nan,
        }

    return {
        "min": float(np.nanmin(finite)),
        "max": float(np.nanmax(finite)),
        "mean": float(np.nanmean(finite)),
        "median": float(np.nanmedian(finite)),
    }


# =============================================================================
# CURVE FUNCTIONS
# =============================================================================

def parse_custom_curve(curve_text):
    points = []

    for pair in curve_text.split(","):
        pair = pair.strip()
        if not pair:
            continue

        if ":" not in pair:
            raise ValueError(f"Invalid curve point: {pair}. Use depth:n format.")

        d_txt, n_txt = pair.split(":", 1)
        depth = float(d_txt.strip())
        n_value = float(n_txt.strip())
        points.append((depth, n_value))

    if len(points) < 2:
        raise ValueError("At least two curve points are required.")

    points = sorted(points, key=lambda x: x[0])

    depths = np.array([p[0] for p in points], dtype=float)
    n_values = np.array([p[1] for p in points], dtype=float)

    if np.any(np.diff(depths) <= 0):
        raise ValueError("Curve depths must be strictly increasing.")

    return depths, n_values


def get_curve(args):
    if args.curve_points:
        return parse_custom_curve(args.curve_points)

    if args.units == "meter":
        curve = HEC15_CLASS_C_CURVE_METERS
    else:
        curve = HEC15_CLASS_C_CURVE_FEET

    depths = np.array([p[0] for p in curve], dtype=float)
    n_values = np.array([p[1] for p in curve], dtype=float)

    return depths, n_values


def compute_depth_varying_n(depth, curve_depths, curve_n_values, min_n, max_n):
    depth = np.asarray(depth, dtype=float)
    depth = np.maximum(depth, 0.0)

    n_values = np.interp(
        depth,
        curve_depths,
        curve_n_values,
        left=curve_n_values[0],
        right=curve_n_values[-1],
    )

    n_values = np.clip(n_values, min_n, max_n)
    return n_values


# =============================================================================
# FACE PROCESSING
# =============================================================================

def build_face_slices_from_info(info_matrix, total_value_rows):
    """
    HEC-RAS Faces Area Elevation Info normally has:
        column 0 = start row in Values table
        column 1 = row count for that face
    """
    if info_matrix.shape[1] < 2:
        raise ValueError("Info table has fewer than 2 columns.")

    starts = np.round(info_matrix[:, 0]).astype(int)
    counts = np.round(info_matrix[:, 1]).astype(int)

    face_slices = []

    for face_index, (start, count) in enumerate(zip(starts, counts)):
        if start < 0:
            continue

        if count <= 1:
            continue

        if start >= total_value_rows:
            continue

        end = min(start + count, total_value_rows)
        actual_count = end - start

        if actual_count <= 1:
            continue

        face_slices.append((face_index, start, actual_count))

    return face_slices


def process_values_dataset(hdf, values_path, args):
    values_ds = hdf[values_path]
    values_matrix, original_structured, field_names = read_numeric_matrix(values_ds)

    if values_matrix.shape[1] < 4:
        raise ValueError(
            f"Values table /{values_path} has only {values_matrix.shape[1]} columns. "
            "Expected at least 4 columns."
        )

    info_path = find_info_dataset_for_values(hdf, values_path)

    if info_path is None:
        raise ValueError(f"Could not find matching Info table for /{values_path}.")

    info_ds = hdf[info_path]
    info_matrix, _, _ = read_numeric_matrix(info_ds)

    elev_col = args.elev_col
    n_col = args.n_col

    if elev_col < 0 or elev_col >= values_matrix.shape[1]:
        raise ValueError(f"Invalid elevation column index: {elev_col}")

    if n_col < 0 or n_col >= values_matrix.shape[1]:
        raise ValueError(f"Invalid Manning's n column index: {n_col}")

    elevations = values_matrix[:, elev_col].astype(float)
    original_n = values_matrix[:, n_col].astype(float)

    face_slices = build_face_slices_from_info(
        info_matrix=info_matrix,
        total_value_rows=values_matrix.shape[0],
    )

    if not face_slices:
        raise ValueError("Could not build face slices from Info table.")

    curve_depths, curve_n_values = get_curve(args)

    new_n_all = original_n.copy()
    all_depths = np.zeros_like(original_n, dtype=float)

    audit_rows = []

    for face_index, start, count in face_slices:
        end = start + count

        face_elev = elevations[start:end]
        face_original_n = original_n[start:end]

        local_min_elev = np.nanmin(face_elev)
        local_depth = face_elev - local_min_elev
        local_depth = np.maximum(local_depth, 0.0)

        computed_n = compute_depth_varying_n(
            depth=local_depth,
            curve_depths=curve_depths,
            curve_n_values=curve_n_values,
            min_n=args.min_n,
            max_n=args.max_n,
        )

        if args.keep_first_row:
            computed_n[0] = face_original_n[0]

        if args.keep_last_row:
            computed_n[-1] = face_original_n[-1]

        final_n = (args.blend * computed_n) + ((1.0 - args.blend) * face_original_n)
        final_n = np.clip(final_n, args.min_n, args.max_n)

        new_n_all[start:end] = final_n
        all_depths[start:end] = local_depth

        audit_rows.append(
            {
                "dataset": f"/{values_path}",
                "face_index": face_index,
                "start_row": start,
                "row_count": count,
                "min_elevation": float(np.nanmin(face_elev)),
                "max_elevation": float(np.nanmax(face_elev)),
                "max_estimated_depth_or_R": float(np.nanmax(local_depth)),
                "original_n_min": float(np.nanmin(face_original_n)),
                "original_n_max": float(np.nanmax(face_original_n)),
                "original_n_mean": float(np.nanmean(face_original_n)),
                "new_n_min": float(np.nanmin(final_n)),
                "new_n_max": float(np.nanmax(final_n)),
                "new_n_mean": float(np.nanmean(final_n)),
                "delta_n_mean": float(np.nanmean(final_n - face_original_n)),
            }
        )

    values_matrix[:, n_col] = new_n_all

    if not args.preview:
        write_numeric_matrix(
            ds=values_ds,
            matrix=values_matrix,
            original_structured=original_structured,
            field_names=field_names,
        )

    original_stats = stats_dict(original_n)
    new_stats = stats_dict(new_n_all)
    depth_stats = stats_dict(all_depths)

    summary = {
        "values_path": f"/{values_path}",
        "info_path": f"/{info_path}",
        "faces_modified": int(len(face_slices)),
        "rows_modified": int(sum(c for _, _, c in face_slices)),
        "elevation_column": int(elev_col),
        "manning_n_column": int(n_col),
        "blend": float(args.blend),
        "keep_first_row": bool(args.keep_first_row),
        "keep_last_row": bool(args.keep_last_row),
        "original_n_min": original_stats["min"],
        "original_n_max": original_stats["max"],
        "original_n_mean": original_stats["mean"],
        "original_n_median": original_stats["median"],
        "new_n_min": new_stats["min"],
        "new_n_max": new_stats["max"],
        "new_n_mean": new_stats["mean"],
        "new_n_median": new_stats["median"],
        "delta_n_mean": float(new_stats["mean"] - original_stats["mean"]),
        "estimated_depth_min": depth_stats["min"],
        "estimated_depth_max": depth_stats["max"],
        "estimated_depth_mean": depth_stats["mean"],
    }

    return summary, audit_rows


